{
  "cli": {
    "version": ">= 20.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "env": {
        "EXPO_PUBLIC_API_URL": "http://timerbook.com.br:8080",
        "EXPO_PUBLIC_WEB_URL": "http://timerbook.com.br"
      },
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "env": {
        "EXPO_PUBLIC_API_URL": "http://timerbook.com.br:8080",
        "EXPO_PUBLIC_WEB_URL": "http://timerbook.com.br"
      },
      "distribution": "internal"
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_URL": "http://timerbook.com.br:8080",
        "EXPO_PUBLIC_WEB_URL": "http://timerbook.com.br"
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
